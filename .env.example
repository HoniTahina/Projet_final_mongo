# Copiez ce fichier en `.env` et changez TOUS les mots de passe.
# `.env` est ignoré par Git — `.env.example` est le seul des deux à être commité.

# Compte administrateur : sert à créer la base et l'utilisateur applicatif.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changez-moi-vraiment

# Compte utilisé par l'API : readWrite sur UNE seule base, jamais root.
MONGO_APP_USER=app
MONGO_APP_PASSWORD=changez-moi-aussi

# Base et collection principale du projet.
MONGO_DB=projet
COLLECTION=items

# Origine autorisée à appeler l'API. En production : l'URL exacte du front, jamais "*".
CORS_ORIGIN=http://localhost:3000

# Création automatique des index au démarrage de l'API.
# Passez à `false` le temps de capturer l'explain() "AVANT" exigé au § 1.5 :
#   AUTO_INDEX=false docker compose up -d
#   curl "localhost:8000/agg/explain?categorie=demo"   -> COLLSCAN
#   curl -X POST localhost:8000/admin/index
#   curl "localhost:8000/agg/explain?categorie=demo"   -> FETCH <- IXSCAN
# Puis remettez `true` : un index ne doit pas dépendre d'un geste manuel.
AUTO_INDEX=true
